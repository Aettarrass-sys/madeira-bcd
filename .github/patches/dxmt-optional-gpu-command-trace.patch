+/* The detailed first-error ring allocates NSStrings and updates dictionaries
+ * for every Metal command. Keep command-buffer error reporting active, but
+ * require an explicit opt-in for this costly per-command forensic trace. */
+static _Atomic int g_madeira_gpu_trace_mode = -1;
+static int madeira_gpu_trace_on(void) {
+  int mode = atomic_load_explicit(&g_madeira_gpu_trace_mode, memory_order_relaxed);
+  if (mode < 0) {
+    const char *value = getenv("DXMT_GPU_COMMAND_TRACE");
+    const int selected = value && value[0] == '1';
+    int expected = -1;
+    if (atomic_compare_exchange_strong_explicit(&g_madeira_gpu_trace_mode, &expected,
+                                                selected, memory_order_relaxed, memory_order_relaxed))
+      fprintf(stderr, "[gpu-command-trace] %s (DXMT_GPU_COMMAND_TRACE=1 enables full trace)\n",
+              selected ? "enabled" : "disabled");
+    mode = atomic_load_explicit(&g_madeira_gpu_trace_mode, memory_order_relaxed);
+  }
+  return mode == 1;
+}
