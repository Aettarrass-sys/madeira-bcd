   if (params->ret) ios_frame_pass(2, 0, 0, 0);
   return STATUS_SUCCESS;
 }
@@ -1305,6 +1397,13 @@ _MTLCommandBuffer_renderCommandEncoder(void *obj) {
   descriptor.visibilityResultBuffer = (id<MTLBuffer>)info->visibility_buffer;
 
   params->ret = (obj_handle_t)[(id<MTLCommandBuffer>)params->handle renderCommandEncoderWithDescriptor:descriptor];
+  NSString *attachment = [NSString stringWithFormat:@"target=%ux%u c0=%p depth=%p sample=%u",
+                          info->render_target_width, info->render_target_height,
+                          (void *)(uintptr_t)info->colors[0].texture,
+                          (void *)(uintptr_t)info->depth.texture,
+                          info->default_raster_sample_count];
+  madeira_gpu_trace_encoder((id<MTLCommandBuffer>)params->handle,
+                            (id<MTLCommandEncoder>)params->ret, "render", attachment);
 
   /* Count realized native passes, including clears and the final present.
    * No new PE ABI or emulated hot-path counters are needed. */
@@ -1900,6 +1999,8 @@ _MTLBlitCommandEncoder_encodeCommands(void *obj) {
   wmt_census_batch(next, 2);
   id<MTLBlitCommandEncoder> encoder = (id<MTLBlitCommandEncoder>)params->encoder;
   while (next) {
+    madeira_gpu_trace_command(encoder,
+        [NSString stringWithFormat:@"blit opcode=%u", (unsigned)next->type]);
     switch ((enum WMTBlitCommandType)next->type) {
     default:
       assert(!next->type && "unhandled blit command type");
@@ -2076,6 +2177,8 @@ _MTLComputeCommandEncoder_encodeCommands(void *obj) {
   id<MTLComputeCommandEncoder> encoder = (id<MTLComputeCommandEncoder>)params->encoder;
   MTLSize threadgroup_size = {0, 0, 0};
   while (next) {
+    madeira_gpu_trace_command(encoder,
+        [NSString stringWithFormat:@"compute opcode=%u", (unsigned)next->type]);
     switch ((enum WMTComputeCommandType)next->type) {
     default:
       assert(!next->type && "unhandled compute command type");
@@ -2233,6 +2336,47 @@ _MTLRenderCommandEncoder_encodeCommands(void *obj) {
   wmt_census_batch(next, 0);
   id<MTLRenderCommandEncoder> encoder = (id<MTLRenderCommandEncoder>)params->encoder;
   while (next) {
+    NSString *operation = [NSString stringWithFormat:@"render opcode=%u", (unsigned)next->type];
+    switch ((enum WMTRenderCommandType)next->type) {
+    case WMTRenderCommandSetVertexBuffer:
+    case WMTRenderCommandSetFragmentBuffer: {
+      const struct wmtcmd_render_setbuffer *b = (const void *)next;
+      operation = [NSString stringWithFormat:@"render opcode=%u buffer=%p offset=%llu slot=%u",
+          (unsigned)next->type, (void *)(uintptr_t)b->buffer,
+          (unsigned long long)b->offset, (unsigned)b->index];
+      break;
+    }
+    case WMTRenderCommandSetFragmentTexture:
+    case WMTRenderCommandSetVertexTexture: {
+      const struct wmtcmd_render_settexture *b = (const void *)next;
+      operation = [NSString stringWithFormat:@"render opcode=%u texture=%p slot=%u",
+          (unsigned)next->type, (void *)(uintptr_t)b->texture, (unsigned)b->index];
+      break;
+    }
+    case WMTRenderCommandSetPSO: {
+      const struct wmtcmd_render_setpso *b = (const void *)next;
+      operation = [NSString stringWithFormat:@"render PSO=%p", (void *)(uintptr_t)b->pso];
+      break;
+    }
+    case WMTRenderCommandDraw: {
+      const struct wmtcmd_render_draw *b = (const void *)next;
+      operation = [NSString stringWithFormat:@"render draw primitive=%u start=%llu count=%llu instances=%u",
+          (unsigned)b->primitive_type, (unsigned long long)b->vertex_start,
+          (unsigned long long)b->vertex_count, b->instance_count];
+      break;
+    }
+    case WMTRenderCommandDrawIndexed: {
+      const struct wmtcmd_render_draw_indexed *b = (const void *)next;
+      operation = [NSString stringWithFormat:@"render draw-indexed primitive=%u indices=%llu index-buffer=%p offset=%llu",
+          (unsigned)b->primitive_type, (unsigned long long)b->index_count,
+          (void *)(uintptr_t)b->index_buffer, (unsigned long long)b->index_buffer_offset];
+      break;
+    }
+    default: break;
+    }
+    madeira_gpu_trace_command(encoder, operation);
+    if (next->type == WMTRenderCommandDraw || next->type == WMTRenderCommandDrawIndexed)
+      [encoder insertDebugSignpost:operation];
     switch ((enum WMTRenderCommandType)next->type) {
     default:
       assert(!next->type && "unhandled render command type");
@@ -3593,7 +3737,13 @@ _MTLCommandEncoder_setLabel(void *args) {
     }
     return STATUS_SUCCESS;
   }
-  [(id<MTLCommandEncoder>)params->handle setLabel:(NSString *)params->arg];
