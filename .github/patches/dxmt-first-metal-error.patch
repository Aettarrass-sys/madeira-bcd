@@ -411,6 +411,42 @@ _NSAutoreleasePool_alloc_init(void *obj) {
   return STATUS_SUCCESS;
 }
 
+/* Diagnostic-only, bounded per-buffer traces. The i386 frontend calls these
+ * same native unix slots, so this covers the default emulated D3D9 path. */
+static _Atomic uint64_t g_madeira_gpu_buffer_serial;
+static _Atomic uint64_t g_madeira_gpu_encoder_serial;
+static _Atomic int g_madeira_first_metal_error_logged;
+static char g_madeira_gpu_trace_key;
+static char g_madeira_gpu_encoder_trace_key;
+
+static void
+madeira_gpu_trace_encoder(id<MTLCommandBuffer> buffer, id<MTLCommandEncoder> encoder,
+                          const char *kind, NSString *details) {
+  if (!encoder) return;
+  uint64_t serial = atomic_fetch_add_explicit(&g_madeira_gpu_encoder_serial, 1, memory_order_relaxed) + 1;
+  NSString *label = [NSString stringWithFormat:@"%@ enc=%llu %s %@",
+                     buffer.label ?: @"Madeira cb=?", (unsigned long long)serial, kind,
+                     details ?: @""];
+  encoder.label = label;
+  NSMutableDictionary *record = [NSMutableDictionary dictionaryWithObjectsAndKeys:
+      label, @"label", [NSMutableArray array], @"recent", @0, @"count", nil];
+  objc_setAssociatedObject(encoder, &g_madeira_gpu_encoder_trace_key,
+                           record, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  NSMutableDictionary *all = objc_getAssociatedObject(buffer, &g_madeira_gpu_trace_key);
+  if (all) all[label] = record;
+}
+
+static void
+madeira_gpu_trace_command(id<MTLCommandEncoder> encoder, NSString *operation) {
+  NSMutableDictionary *record = objc_getAssociatedObject(encoder, &g_madeira_gpu_encoder_trace_key);
+  if (!record) return;
+  unsigned long long count = [record[@"count"] unsignedLongLongValue] + 1;
+  record[@"count"] = @(count);
+  NSMutableArray *recent = record[@"recent"];
+  if (recent.count == 64) [recent removeObjectAtIndex:0];
+  [recent addObject:[NSString stringWithFormat:@"#%llu %@", count, operation]];
+}
+
 static NTSTATUS
 _MTLCommandQueue_commandBuffer(void *obj) {
   struct unixcall_generic_obj_obj_ret *params = obj;
@@ -421,7 +457,17 @@ _MTLCommandQueue_commandBuffer(void *obj) {
     wmtr_pool_push(params->ret);   /* ml820: autoreleased natively */
     return STATUS_SUCCESS;
   }
-  params->ret = (obj_handle_t)[(id<MTLCommandQueue>)params->handle commandBuffer];
+  MTLCommandBufferDescriptor *desc = [MTLCommandBufferDescriptor new];
+  desc.errorOptions = MTLCommandBufferErrorOptionEncoderExecutionStatus;
+  id<MTLCommandBuffer> buffer = [(id<MTLCommandQueue>)params->handle commandBufferWithDescriptor:desc];
+  [desc release];
+  if (buffer) {
+    uint64_t serial = atomic_fetch_add_explicit(&g_madeira_gpu_buffer_serial, 1, memory_order_relaxed) + 1;
+    buffer.label = [NSString stringWithFormat:@"Madeira cb=%llu", (unsigned long long)serial];
+    objc_setAssociatedObject(buffer, &g_madeira_gpu_trace_key,
+                             [NSMutableDictionary dictionary], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  }
+  params->ret = (obj_handle_t)buffer;
   return STATUS_SUCCESS;
 }
 
@@ -448,6 +494,48 @@ _MTLCommandBuffer_commit(void *obj) {
       ios_frame_gpu(buffer.GPUStartTime > 0.0 && span > 0.0 ? (unsigned long long)(span * 1e9) : 0, depth);
     }];
   }
+  [(id<MTLCommandBuffer>)params->handle addCompletedHandler:^(id<MTLCommandBuffer> buffer) {
+    if (buffer.status != MTLCommandBufferStatusError ||
+        atomic_exchange_explicit(&g_madeira_first_metal_error_logged, 1, memory_order_relaxed)) return;
+    @autoreleasepool {
+      NSError *error = buffer.error;
+      fprintf(stderr, "[gpu-first-metal] buffer=%s code=%ld error=%s\n",
+              buffer.label.UTF8String ?: "?", (long)error.code,
+              error.localizedDescription.UTF8String ?: "?");
+      NSArray *infos = error.userInfo[MTLCommandBufferEncoderInfoErrorKey];
+      NSMutableDictionary *all = objc_getAssociatedObject(buffer, &g_madeira_gpu_trace_key);
+      fprintf(stderr, "[gpu-first-metal] encoder-info=%lu traced-encoders=%lu\n",
+              (unsigned long)infos.count, (unsigned long)all.count);
+      BOOL matched = NO;
+      for (id<MTLCommandBufferEncoderInfo> info in infos) {
+        NSString *label = info.label;
+        fprintf(stderr, "[gpu-first-metal-encoder] state=%ld label=%s\n",
+                (long)info.errorState, label.UTF8String ?: "?");
+        for (NSString *signpost in info.debugSignposts)
+          fprintf(stderr, "[gpu-first-metal-signpost] %s\n", signpost.UTF8String);
+        NSMutableDictionary *record = all[label];
+        if (record) {
+          matched = YES;
+          fprintf(stderr, "[gpu-first-metal-trace] total-commands=%llu recent=%lu\n",
+                  [record[@"count"] unsignedLongLongValue],
+                  (unsigned long)[record[@"recent"] count]);
+          for (NSString *line in record[@"recent"])
+            fprintf(stderr, "[gpu-first-metal-trace] %s\n", line.UTF8String);
+        }
+      }
+      if (!matched) {
+        fprintf(stderr, "[gpu-first-metal] encoder label unavailable; dumping bounded traces for this buffer\n");
+        for (NSString *label in all) {
+          NSMutableDictionary *record = all[label];
+          fprintf(stderr, "[gpu-first-metal-trace] label=%s total-commands=%llu\n",
+                  label.UTF8String, [record[@"count"] unsignedLongLongValue]);
+          for (NSString *line in record[@"recent"])
+            fprintf(stderr, "[gpu-first-metal-trace] %s\n", line.UTF8String);
+        }
+      }
+      fflush(stderr);
+    }
+  }];
   [(id<MTLCommandBuffer>)params->handle commit];
   return STATUS_SUCCESS;
 }
@@ -1217,6 +1305,8 @@ _MTLCommandBuffer_blitCommandEncoder(void *obj) {
     return STATUS_SUCCESS;
   }
   params->ret = (obj_handle_t)[(id<MTLCommandBuffer>)params->handle blitCommandEncoder];
+  madeira_gpu_trace_encoder((id<MTLCommandBuffer>)params->handle,
