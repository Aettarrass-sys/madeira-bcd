diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 183dddc9..8cddf5d6 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -286,7 +286,8 @@ static pthread_mutex_t mnt_mutex = PTHREAD_MUTEX_INITIALIZER;
  * notes at each cache.
  */
 
-#define IOS_FSA(v,n)  __atomic_fetch_add( &(v), (unsigned long long)(n), __ATOMIC_RELAXED )
+static int ios_fs_disabled(void);
+#define IOS_FSA(v,n)  do { if (!ios_fs_disabled()) __atomic_fetch_add( &(v), (unsigned long long)(n), __ATOMIC_RELAXED ); } while (0)
 #define IOS_FSL(v)    __atomic_load_n( &(v), __ATOMIC_RELAXED )
 
 enum ios_fs_op { IOS_OP_OPEN, IOS_OP_CREATE, IOS_OP_QATTR, IOS_OP_QFULL,
@@ -337,6 +338,7 @@ static unsigned long long ios_fs_open_lk_fail_us;
 static inline unsigned long long ios_fs_now_us(void)
 {
     struct timespec ts;
+    if (ios_fs_disabled()) return 0;
     if (clock_gettime( CLOCK_MONOTONIC, &ts )) return 0;
     return (unsigned long long)ts.tv_sec * 1000000ull + (unsigned long long)ts.tv_nsec / 1000;
 }
@@ -447,7 +449,8 @@ static int ios_fs_disabled(void)
     if (v < 0)
     {
         const char *s = getenv( "MADEIRA_FSSTATS" );
-        v = (s && s[0] == '0') ? 1 : 0;
+        const char *diag = getenv( "MADEIRA_DIAG" );
+        v = s ? (s[0] == '1' ? 0 : 1) : !(diag && diag[0] == '1');
         __atomic_store_n( &ios_fs_off, v, __ATOMIC_RELAXED );
     }
     return v;
