@@ -33,6 +33,7 @@
  * dxguid and its import set stays KERNEL32/USER32/GDI32/api-ms-win-crt-*. */
 #define INITGUID
 
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -1383,6 +1384,89 @@ d3d9shim_shadow_apply(struct d3d9shim_device *dev, unsigned int op,
     table_unlock();
 }
 
+/* The native handle table owns one public reference per guest wrapper, even
+ * after its guest public count returns to zero. Native non-Ex Reset counts
+ * that reference as a live DEFAULT-pool object. Retire unowned cached wrappers
+ * before Reset; guest-held wrappers keep their identity and native handle. */
+void
+d3d9shim_device_prune_unreferenced_before_reset(struct d3d9shim_device *dev)
+{
+    unsigned int i, j;
+    unsigned int pruned = 0, held = 0;
+    static LONG reported;
+    char line[160];
+
+    if (!dev)
+        return;
+    table_lock();
+    for (i = 0; i < D3D9SHIM_MAX_SWAPCHAINS; i++) {
+        struct d3d9shim_object *sc = dev->swapchains[i];
+
+        if (!sc)
+            continue;
+        for (j = 0; j < D3D9SHIM_MAX_BACK_BUFFERS; j++) {
+            struct d3d9shim_object *bb = D3D9SHIM_IMPL(sc)->o.swapchain.back_buffers[j];
+
+            if (bb && !bb->refcount) {
+                drop_child(&D3D9SHIM_IMPL(sc)->o.swapchain.back_buffers[j]);
+                pruned++;
+            } else if (bb) held++;
+        }
+        if (!sc->refcount) {
+            drop_child(&dev->swapchains[i]);
+            pruned++;
+        } else held++;
+    }
+    for (i = 0; i < D3D_MAX_SIMULTANEOUS_RENDERTARGETS; i++) {
+        struct d3d9shim_object *rt = dev->render_targets[i];
+
+        if (rt && !rt->refcount) {
+            drop_child(&dev->render_targets[i]);
+            pruned++;
+        } else if (rt) held++;
+    }
+    if (dev->depth_stencil) {
+        if (!dev->depth_stencil->refcount) {
+            drop_child(&dev->depth_stencil);
+            pruned++;
+        } else held++;
+    }
+    /* Bound resources have a native public ref owned by their handle even
+     * when the application released its last guest ref. Native Reset counts
+     * that ref as a live DEFAULT resource. Its device binding still has an
+     * internal ref; Reset clears the binding on success, so retire only the
+     * wrapper's unowned cached ref here. */
+    for (i = 0; i < D3D9SHIM_MAX_TEXTURE_SLOTS; i++) {
+        struct d3d9shim_object *tex = dev->textures[i];
+
+        if (tex && !tex->refcount) {
+            drop_child(&dev->textures[i]);
+            pruned++;
+        } else if (tex) held++;
+    }
+    for (i = 0; i < D3D9_MAX_VERTEX_STREAMS; i++) {
+        struct d3d9shim_object *vb = dev->stream_buffers[i];
+
+        if (vb && !vb->refcount) {
+            drop_child(&dev->stream_buffers[i]);
+            pruned++;
+        } else if (vb) held++;
+    }
+    if (dev->index_buffer) {
+        if (!dev->index_buffer->refcount) {
+            drop_child(&dev->index_buffer);
+            pruned++;
+        } else held++;
+    }
+    table_unlock();
+    if (!InterlockedCompareExchange(&reported, 1, 0)
+            && GetEnvironmentVariableA("MADEIRA_D3D9_NATIVE_CENSUS", NULL, 0)) {
+        snprintf(line, sizeof(line), "[d3d9-reset-cache] pruned=%u guest-held=%u",
+                 pruned, held);
+        d3d9shim_trace(line);
+    }
+}
+
