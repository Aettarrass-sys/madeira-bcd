+/* A resolved implicit child owns one native public reference even after its
+ * guest public count returns to zero. The cache normally releases that native
+ * reference on a successful Reset, but native non-Ex Reset rejects it as a
+ * live DEFAULT-pool object before it can succeed. Drop only unowned cache
+ * entries first; guest-held wrappers retain their identity and native ref. */
+void
+d3d9shim_device_prune_unreferenced_implicit(struct d3d9shim_device *dev)
+{
+    unsigned int i, j;
+
+    if (!dev)
+        return;
+    table_lock();
+    for (i = 0; i < D3D9SHIM_MAX_SWAPCHAINS; i++) {
+        struct d3d9shim_object *sc = dev->swapchains[i];
+
+        if (!sc)
+            continue;
+        for (j = 0; j < D3D9SHIM_MAX_BACK_BUFFERS; j++) {
+            struct d3d9shim_object *bb = D3D9SHIM_IMPL(sc)->o.swapchain.back_buffers[j];
+
+            if (bb && !bb->refcount)
+                drop_child(&D3D9SHIM_IMPL(sc)->o.swapchain.back_buffers[j]);
+        }
+        if (!sc->refcount)
+            drop_child(&dev->swapchains[i]);
+    }
+    for (i = 0; i < D3D_MAX_SIMULTANEOUS_RENDERTARGETS; i++) {
+        struct d3d9shim_object *rt = dev->render_targets[i];
+
+        if (rt && !rt->refcount)
+            drop_child(&dev->render_targets[i]);
+    }
+    if (dev->depth_stencil && !dev->depth_stencil->refcount)
+        drop_child(&dev->depth_stencil);
+    table_unlock();
+}
+
