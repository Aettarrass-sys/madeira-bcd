--- /dev/null
+++ b/src/d3d9/d3d9_batch_stream.hpp
@@ -0,0 +1,89 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+namespace dxmt {
+// Publish a reference only after both allocations and the payload construction
+// have succeeded. A failed reserve must not leave a dangling stream entry.
+template <typename Ops, typename Payloads, typename Kind, typename T>
+void d9AppendBatchOp(Ops &ops, Payloads &payloads, Kind kind, T &&payload) {
+  static_assert(std::is_nothrow_move_constructible_v<typename Payloads::value_type>);
+  static_assert(std::is_nothrow_copy_constructible_v<typename Ops::value_type>);
+  if (payloads.size() >= std::numeric_limits<uint32_t>::max())
+    throw std::length_error("D3D9 batch index overflow");
+  auto grow = [](auto &v) {
+    if (v.size() == v.capacity()) {
+      const auto capacity = v.capacity();
+      const auto next = capacity <= v.max_size() / 2 ? capacity * 2 : v.max_size();
+      v.reserve(std::max(v.size() + 1, next));
+    }
+  };
+  grow(ops);
+  grow(payloads);
+  const auto index = static_cast<uint32_t>(payloads.size());
+  payloads.push_back(std::forward<T>(payload));
+  ops.push_back({kind, index});
+}
+
+// Swap all storage out before allocating/emitting the command closure. The
+// recorder's next batch cannot alias storage being consumed by the encoder.
+template <typename Op, typename Draw, typename Blit, typename Ref> struct D9SealedBatch {
+  std::vector<Op> ops;
+  std::vector<Draw> draws;
+  std::vector<Blit> blits;
+  std::vector<Ref> ref_ops;
+
+  D9SealedBatch(std::vector<Op> &o, std::vector<Draw> &d,
+                std::vector<Blit> &b, std::vector<Ref> &r) noexcept {
+    ops.swap(o);
+    draws.swap(d);
+    blits.swap(b);
+    ref_ops.swap(r);
+  }
+  D9SealedBatch(D9SealedBatch &&) noexcept = default;
+  D9SealedBatch(const D9SealedBatch &) = delete;
+
+  // Per-kind records are appended in order, so every index must equal the
+  // next cursor, not merely be within the vector. Reject duplicate references,
+  // unknown tags, missing payloads, and orphan payloads before emitting work.
+  bool valid() const noexcept {
+    size_t draw = 0, blit = 0, ref = 0;
+    for (const auto &op : ops) {
+      switch (op.kind) {
+      case Op::Draw: if (op.index != draw++ || op.index >= draws.size()) return false; break;
+      case Op::Blit: if (op.index != blit++ || op.index >= blits.size()) return false; break;
+      case Op::SetRef: if (op.index != ref++ || op.index >= ref_ops.size()) return false; break;
+      default: return false;
+      }
+    }
+    return draw == draws.size() && blit == blits.size() && ref == ref_ops.size();
+  }
+
+  std::array<uintptr_t, 8> storage() const noexcept {
+    return {reinterpret_cast<uintptr_t>(ops.data()), ops.size(),
+            reinterpret_cast<uintptr_t>(draws.data()), draws.size(),
+            reinterpret_cast<uintptr_t>(blits.data()), blits.size(),
+            reinterpret_cast<uintptr_t>(ref_ops.data()), ref_ops.size()};
+  }
+
+  uint64_t fingerprint() const noexcept {
+    uint64_t hash = 14695981039346656037ull;
+    auto mix = [&hash](uint64_t value) { hash = (hash ^ value) * 1099511628211ull; };
+    mix(ops.size()); mix(draws.size()); mix(blits.size()); mix(ref_ops.size());
+    for (const auto &op : ops) { mix(op.kind); mix(op.index); }
+    for (const auto &op : blits) {
+      mix(static_cast<uint8_t>(op.kind));
+      mix(reinterpret_cast<uintptr_t>(op.src_tex.ptr()));
+      mix(reinterpret_cast<uintptr_t>(op.dst_tex.ptr()));
+    }
+    return hash;
+  }
+};
+} // namespace dxmt
